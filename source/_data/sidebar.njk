<section class="sidebar-ad-card" aria-label="广告">
  <div class="sidebar-ads" style="width:220px;max-width:100%;margin:0 auto;">
  <ins class="adsbygoogle"
       style="display:block;width:100%;"
       data-ad-client="ca-pub-8152962404708167"
       data-ad-slot="4491298754"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  </div>
</section>
<script>
(function () {
  var card = document.querySelector('.sidebar-ad-card');
  if (!card) return;
  var ad = card.querySelector('ins.adsbygoogle');
  if (!ad) {
    card.classList.add('sidebar-ad-unavailable');
    return;
  }

  var fallbackTimer;
  var fallbackStarted = false;
  function collapseCard(collapsed) {
    card.classList.toggle('sidebar-ad-unavailable', collapsed);
    // Recalculate NexT's affix position after the card height changes.
    if (window.Affix && window.Affix.element) window.Affix.checkPosition();
  }

  function syncAdStatus() {
    var status = ad.getAttribute('data-ad-status');
    if (status === 'filled' || status === 'unfill-optimized' || status === 'unfilled') {
      clearTimeout(fallbackTimer);
      collapseCard(status === 'unfilled');
    }
  }

  // Keep watching after a timeout so a late successful response can restore the card.
  var statusObserver = new MutationObserver(syncAdStatus);
  statusObserver.observe(ad, { attributes: true, attributeFilter: ['data-ad-status'] });
  syncAdStatus();

  function waitForAd() {
    if (fallbackStarted) return;
    fallbackStarted = true;
    fallbackTimer = setTimeout(function () {
      if (!ad.getAttribute('data-ad-status')) collapseCard(true);
    }, 15000);
  }

  function start() {
    var loader = document.querySelector('script[data-sidebar-adsense-loader]');
    if (loader && loader.dataset.loadFailed === 'true' && !ad.getAttribute('data-ad-status')) {
      collapseCard(true);
      return;
    }
    var timer;
    var submitted = false;
    var container = ad.parentElement;
    var ancestors = [];
    for (var element = container; element; element = element.parentElement) {
      ancestors.push(element);
    }

    function visibleWidth() {
      if (!ad.isConnected || document.visibilityState === 'hidden') return 0;
      for (var i = 0; i < ancestors.length; i++) {
        var style = window.getComputedStyle(ancestors[i]);
        if (style.display === 'none' || style.visibility !== 'visible' ||
            parseFloat(style.opacity) < 0.99) return 0;
      }
      return container.getBoundingClientRect().width;
    }

    function stop() {
      clearTimeout(timer);
      mutations.disconnect();
      if (resize) resize.disconnect();
      window.removeEventListener('resize', schedule);
      document.removeEventListener('visibilitychange', schedule);
    }

    function schedule() {
      clearTimeout(timer);
      if (submitted) {
        stop();
        return;
      }
      var width = visibleWidth();
      if (width <= 0) return;
      waitForAd();
      if (ad.hasAttribute('data-adsbygoogle-status')) {
        stop();
        return;
      }
      if (ad.getBoundingClientRect().width <= 0 || window.getComputedStyle(ad).display === 'none') return;
      // Wait for NexT's sidebar/panel animation and a stable layout.
      timer = setTimeout(function () {
        if (Math.abs(visibleWidth() - width) > 0.5 || visibleWidth() <= 0) {
          schedule();
          return;
        }
        if (ad.hasAttribute('data-adsbygoogle-status')) {
          stop();
          return;
        }
        submitted = true;
        stop();
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (error) {
          collapseCard(true);
          console.error('Sidebar AdSense initialization failed:', error);
        }
      }, 200);
    }

    // Observe only ancestors: AdSense's own DOM updates must not retrigger it.
    var mutations = new MutationObserver(schedule);
    ancestors.forEach(function (element) {
      mutations.observe(element, { attributes: true, attributeFilter: ['class', 'style', 'hidden'] });
    });
    var resize = window.ResizeObserver ? new ResizeObserver(schedule) : null;
    if (resize) resize.observe(container);
    window.addEventListener('resize', schedule);
    document.addEventListener('visibilitychange', schedule);
    schedule();
  }

  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start, { once: true });
})();
</script>
